FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    software-properties-common \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install KiCad CLI - NOTE: proper installation might require kicad standard install
# For this purpose, we assume kicad-cli is installed or we use the internal DRC fallback
RUN apt-get update && apt-get install -y kicad || echo "KiCad via apt not available directly, relying on internal DRC"

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
